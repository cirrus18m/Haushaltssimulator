# Zugangsdaten für Datenquellen-APIs
#
# Diese Datei ist die Vorlage und wird versioniert. Echte Werte gehören in .env
# (wird nicht committet) oder in die Umgebungsvariablen der Laufzeitumgebung.
# Platzhalter der Form MY_..._HERE gelten als "nicht gesetzt".
#
# Destatis GENESIS-Online (https://www-genesis.destatis.de)
# Variante 1: API-Token aus der Registrierung (wird als HTTP-Header "username" gesendet)
DESTATIS_API_TOKEN=MY_DESTATIS_TOKEN_HERE
# Variante 2: Nutzerkennung und Passwort der GENESIS-Online-Anmeldung
DESTATIS_API_USER=MY_DESTATIS_USER_HERE
DESTATIS_API_PASSWORD=MY_DESTATIS_PASSWORD_HERE
#
# FRED, Federal Reserve Bank of St. Louis (https://fred.stlouisfed.org/docs/api/fred/)
FRED_API_KEY=MY_FRED_API_KEY_HERE
#
# Ohne Schlüssel nutzbar und daher hier nicht nötig:
#   Eurostat Data Browser API, EZB Data Portal (https://data.ecb.europa.eu/),
#   Deutsche Bundesbank, energy-charts.info, Bank of Russia
#
# Weitere Anbieter später – gleiche Struktur verwenden:
# WEITERE_QUELLE_API_KEY=MY_WEITERE_QUELLE_API_KEY_HERE
